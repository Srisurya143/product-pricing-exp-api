	case .flowName -> flow.name
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="common-flow-start-logging-subflow" doc:id="65f2af02-b7dd-44ff-827e-34f22d0fa293" name="common-flow-start-logging-subflow" />
		<ee:transform doc:name="pingResponse" doc:id="61717ae1-c410-4e36-a0f7-6fc3b75a5a0f" >
			<ee:message >
				<ee:set-payload resource="dwl/pingResponse.dwl" />
			</ee:message>
		</ee:transform>
		<flow-ref doc:name="common-flow-end-logging-subflow" doc:id="6b8ad0ad-6522-433f-885f-7e3e4abae7e3" name="common-flow-end-logging-subflow"/>
	</sub-flow>
</mule>
