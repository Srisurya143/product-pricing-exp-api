	<sub-flow name="update-product-implementation-subflow" doc:id="7957e9d0-df71-47f3-890e-ecdc4d1f820b" >
		<ee:transform doc:name="updateFlowname" doc:id="fc9dd9ff-d2e6-4ff9-9657-94a62f0c2452" >
			<ee:message />
			<ee:variables >
				<ee:set-variable variableName="flowName" ><![CDATA[%dw 2.0
output application/json
---
vars.loggingVars update {
	case .flowName -> flow.name
}
]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="common-flow-start-logging-subflow" doc:id="468c561c-a8ae-4a27-bbac-fcf644143bc7" name="common-flow-start-logging-subflow" />
		<flow-ref doc:name="common-before-request-logging-subflow" doc:id="f4356465-a792-4c56-bea4-5858c6392292" name="common-before-request-logging-subflow" />
		<http:request doc:name="productsPricingPrcApiUpdateRequest" doc:id="0a499708-663b-477e-9a27-8e12809c9fc0" config-ref="product-pricing-prc-api-httpRequester-config" method="PATCH" path="${productPricingPrcApi.productByIdPath}" >
			<http:uri-params ><![CDATA[#[output application/java
---
{
	productId : attributes.uriParams.'productId'
}]]]></http:uri-params>
		</http:request>
		<flow-ref doc:name="common-after-request-logging-subflow" doc:id="ec45aeaa-4599-46e0-890a-dc334e54f746" name="common-after-request-logging-subflow" />
		<flow-ref doc:name="common-flow-end-logging-subflow" doc:id="102c9e9a-3f27-4346-aa06-9a98b5351ac3" name="common-flow-end-logging-subflow" />
	</sub-flow>
</mule>
