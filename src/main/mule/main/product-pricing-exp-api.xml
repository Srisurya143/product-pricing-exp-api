        name: "ej.salesforce.com"
      }
    ]
  },
  status: 200
} as Object {encoding: "UTF-8", mediaType: "application/json"}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
    </flow>
    <flow name="get:\ping:product-pricing-exp-api-config">
		<flow-ref doc:name="ping-implementation-subflow" doc:id="c51d8bcf-9af7-4d78-9a04-49912c1e50c2" name="ping-implementation-subflow"/>
    </flow>
    <flow name="get:\products:product-pricing-exp-api-config">
